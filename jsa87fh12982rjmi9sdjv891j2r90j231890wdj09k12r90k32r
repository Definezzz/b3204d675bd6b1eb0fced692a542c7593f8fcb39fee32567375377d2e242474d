    end

    if holder.ui.menu.visuals_tab.other.hit_logs.outputs:get("Screen") then
        client.color_log(230, 95, 95, "[screen] ")
        client.color_log(225, 225, 225, log_text)
    end

    if holder.ui.menu.visuals_tab.other.hit_logs.outputs:get("Render") then
        screen_log(
            {
                icon = "✗",
                accent = {230, 95, 95},
                text = string.format("Missed %s due to %s in the %s", name, reason, wanted_hitgroup),
                parts = {
                    {text = "Missed ", color = {230, 230, 230}},
                    {text = name, color = {230, 95, 95}},
                    {text = " due to ", color = {230, 230, 230}},
                    {text = reason, color = {230, 95, 95}},
                    {text = " in the ", color = {230, 230, 230}},
                    {text = wanted_hitgroup, color = {230, 95, 95}}
                }
            }
        )
    end
end

local function render_logs()
    if not holder.ui.menu.visuals_tab.other.hit_logs.enabled:get() then
        return
    end
    if not holder.ui.menu.visuals_tab.other.hit_logs.outputs:get("Render") then
        return
    end

    local x, y = client.screen_size()
    local add_y = 0

    for i, v in ipairs(hitlog_state.notifications) do
        local icon_w = v.icon ~= "" and renderer.measure_text("", v.icon .. " ") or 0
        local text_w = renderer.measure_text("", v.string)
        local full_w = icon_w + text_w
        local start_x = x / 2 - 8 - full_w / 2
        local end_x = x / 2 + full_w + 7 - full_w / 2
        local start_y = y / 2 + 145 + add_y
        local end_y = y / 2 + 165 + add_y

        v.timer = v.timer + (0.19 * full_w * 0.0115) * hitlogs_frametime() * 14

        if math.max(0, (full_w + 1 - v.timer)) > 0 then
            v.alpha = lerp(v.alpha, 1, hitlogs_frametime())
        end

        local box_w = end_x - start_x
        local box_h = end_y - start_y
        local a = math.floor(v.alpha * 255)
        local bg_a = math.floor(v.alpha * 120)
        local shadow_a = math.floor(v.alpha * 28)
        local ar, ag, ab = v.accent[1], v.accent[2], v.accent[3]

        renderer.rectangle(start_x - 3, start_y - 2, box_w + 6, box_h + 4, 0, 0, 0, shadow_a)
        renderer.rectangle(start_x - 2, start_y - 1, box_w + 4, box_h + 2, 0, 0, 0, shadow_a)
        renderer.rectangle(start_x - 1, start_y, box_w + 2, box_h, 0, 0, 0, shadow_a)

        renderer.rectangle(start_x, start_y, box_w, box_h, 16, 16, 20, bg_a)
        renderer.gradient(start_x, start_y, box_w, 1, ar, ag, ab, math.floor(a * 0.65), ar, ag, ab, 0, true)
        renderer.gradient(start_x, end_y - 1, box_w, 1, ar, ag, ab, math.floor(a * 0.55), ar, ag, ab, 0, true)
        renderer.rectangle(start_x, start_y, 2, box_h, ar, ag, ab, math.floor(a * 0.75))

        local draw_x = x / 2 - full_w / 2
        local draw_y = y / 2 + 148 + add_y

        if v.icon ~= "" then
            renderer.text(draw_x, draw_y, ar, ag, ab, a, "", 0, v.icon)
            draw_x = draw_x + icon_w
        end

        if v.parts then
            for _, part in ipairs(v.parts) do
                local pr, pg, pb = part.color[1], part.color[2], part.color[3]
                renderer.text(draw_x, draw_y, pr, pg, pb, a, "", 0, part.text)
                draw_x = draw_x + renderer.measure_text("", part.text)
            end
        else
            renderer.text(draw_x, draw_y, 255, 255, 255, a, "", 0, v.string)
        end

        if math.max(0, (full_w + 1 - v.timer)) == 0 or #hitlog_state.notifications > 5 then
            v.alpha = lerp(v.alpha, 0, hitlogs_frametime() * 3.8)
        end

        if v.alpha < 0.01 or #hitlog_state.notifications > 5 then
            table.remove(hitlog_state.notifications, i)
        end

        add_y = math.floor(add_y + 25 * v.alpha)
    end
end

