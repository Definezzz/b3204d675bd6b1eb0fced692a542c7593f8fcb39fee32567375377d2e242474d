    local function normalize_yaw(angle)
        while angle > 180 do
            angle = angle - 360
        end
        while angle < -180 do
            angle = angle + 360
        end
        return angle
    end

    local function get_next_custom_delay(settings)
        local count = settings.yaw.delay.custom.count:get()
        local mode = settings.yaw.delay.custom.mode:get()
        local default_delay = 1
        if count == 0 or not settings.yaw.delay.custom.delays then
            return default_delay
        end

        local delays = {}
        for i = 1, count do
            if settings.yaw.delay.custom.delays[i] then
                local delay_value = settings.yaw.delay.custom.delays[i]:get()
                if delay_value and type(delay_value) == "number" then
                    table.insert(delays, delay_value)
                end
            end
        end

        if #delays == 0 then
            return default_delay
        end

        if mode == 1 then
            local delay = delays[holder.utilities.antiaim.custom_delay_index]
            return delay or default_delay
        elseif mode == 2 then
            local available_delays = {}
            for i, delay in ipairs(delays) do
                if delay ~= holder.utilities.antiaim.custom_delay_last then
                    table.insert(available_delays, delay)
                end
            end

            if #available_delays == 0 then
                available_delays = delays
            end

            local random_index = math.random(1, #available_delays)
            local selected_delay = available_delays[random_index]
            holder.utilities.antiaim.custom_delay_last = selected_delay
            return selected_delay or default_delay
        else
            local random_index = math.random(1, #delays)
            local selected_delay = delays[random_index]
            return selected_delay or default_delay
        end
    end

    function holder.utilities.antiaim.get_player_state(cmd)
        local lp = entity.get_local_player()
        if lp == nil then
            return "Shared"
        end
        local flags = entity.get_prop(lp, "m_fFlags")
        local velocity = {entity.get_prop(lp, "m_vecVelocity")}
        local speed = math.sqrt(velocity[1] ^ 2 + velocity[2] ^ 2)
        local on_ground = bit.band(flags, 1) ~= 0
        local ducking =
            entity.get_prop(lp, "m_flDuckAmount") > 0.7 or ui.get(holder.utilities.reference.rage_fake_duck[1])
        local in_slow_walk =
            ui.get(holder.utilities.reference.aa_slow_walk[1]) and ui.get(holder.utilities.reference.aa_slow_walk[2])
        local fs_active =
            holder.ui.menu.antiaim_tab.other.hotkey.freestanding:get() and
            holder.utilities.antiaim.manual_direction == 0
        if not holder.utilities.antiaim.landing_time then
            holder.utilities.antiaim.landing_time = 0
        end
        local was_in_air = holder.utilities.antiaim.was_in_air or false
        if was_in_air and on_ground then
            holder.utilities.antiaim.landing_time = globals.curtime()
        end
        holder.utilities.antiaim.was_in_air = not on_ground
        local recently_landed = (globals.curtime() - holder.utilities.antiaim.landing_time) < 0.05
        if fs_active then
            return "Freestanding"
        elseif not on_ground then
            if ducking then
                return "Air-Crouch"
            else
                return "Air"
            end
        elseif cmd.in_jump == 1 then
            if ducking then
                return "Air-Crouch"
            else
                return "Air"
            end
        elseif recently_landed then
            if ducking then
                return "Air-Crouch"
            else
                return "Air"
            end
        elseif ducking then
            if speed > 10 then
                return "Crouch-Walk"
            else
                return "Crouching"
            end
        elseif in_slow_walk and speed > 10 then
            return "Slow-Walk"
        elseif speed > 5 then
            return "Running"
        elseif speed <= 5 then
            return "Standing"
        else
            return "Shared"
        end
    end

    local avoid_backstab_yaw_offset = 0

    local function avoid_backstab_check_active()
        local select = holder.ui.menu.antiaim_tab.other.additional.select
        local amount = holder.ui.menu.antiaim_tab.other.additional.avoid_backstab.amount:get()

        if amount == 0 or not select:get("Avoid Backstab") then
            return false
        end

        local me = entity.get_local_player()
        if me == nil or not entity.is_alive(me) then
            return false
        end

        local origin = vector(entity.get_prop(me, "m_vecOrigin"))
        local players = entity.get_players(true)

        local best_delta = nil
        local best_distancesqr = math.huge

        for i = 1, #players do
            local enemy = players[i]
            local weapon = entity.get_player_weapon(enemy)
            if weapon then
                local weapon_info = csgo_weapons(weapon)
                if weapon_info ~= nil and weapon_info.idx ~= 31 and weapon_info.type == "knife" then
                    local enemy_origin = vector(entity.get_prop(enemy, "m_vecOrigin"))
                    local delta = enemy_origin - origin
                    local distancesqr = delta:lengthsqr()

                    if distancesqr < best_distancesqr then
                        best_distancesqr = distancesqr
                        best_delta = delta
                    end
                end
            end
        end

        if best_delta == nil then
            return false
        end

        local max_distance_sqr = amount * amount
        if best_distancesqr > max_distance_sqr then
            return false
        end

        local _, yaw = best_delta:angles()
        avoid_backstab_yaw_offset = normalize_yaw(yaw)
        return true
    end

