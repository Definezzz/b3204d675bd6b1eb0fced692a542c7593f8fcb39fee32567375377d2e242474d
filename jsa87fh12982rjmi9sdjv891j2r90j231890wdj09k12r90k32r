    builder_package_t = pui.setup(holder.ui.antiaim_states_t)

    builder_package_ct = pui.setup(holder.ui.antiaim_states_ct)

    aa_config_t = builder_package_t:save()

    aa_config_ct = builder_package_ct:save()

    package = pui.setup(holder.ui.menu)

    config = package:save()

    local config_system, protected, presets = {}, {}, {}

    config_system.add = function(...)
        args = {...}

        len = #args

        for i = 1, len do
            arg = args[i]

            r, g, b = unpack(arg)

            msg = {}

            if #arg == 3 then
                _G.table.insert(msg, " ")
            else
                for i = 4, #arg do
                    _G.table.insert(msg, arg[i])
                end
            end

            msg = _G.table.concat(msg)

            if len > i then
                msg = msg .. "\0"
            end

            client.color_log(r, g, b, msg)
        end
    end

    protected.database = {
        configs = ":arrested-essentials::configs:"
    }

    config_system.get = function(name)
        local database = database.read(protected.database.configs) or {}

        for i, v in pairs(database) do
            if v.name == name then
                return {
                    config = v.config,
                    config2 = v.config2,
                    config3 = v.config3,
                    index = i
                }
            end
        end

        for i, v in pairs(presets) do
            if v.name == name then
                return {
                    config = v.config,
                    config2 = v.config2,
                    config3 = v.config3,
                    index = i
                }
            end
        end

        return false
    end

    config_system.save = function(name)
        local db = database.read(protected.database.configs) or {}

        local config = {}

        if name:match("[^%*%w%s%-]") ~= nil then
            return
        end

        local config = base64.encode(json.stringify(package:save()))

        local config2 = base64.encode(json.stringify(builder_package_t:save()))

        local config3 = base64.encode(json.stringify(builder_package_ct:save()))

        local cfg = config_system.get(name)

        if not cfg then
            _G.table.insert(db, {name = name, config = config, config2 = config2, config3 = config3})
        else
            db[cfg.index].config = config

            db[cfg.index].config2 = config2

            db[cfg.index].config3 = config3
        end

        database.write(protected.database.configs, db)
    end

    config_system.delete = function(name)
        local db = database.read(protected.database.configs) or {}

        for i, v in pairs(db) do
            if v.name == name then
                _G.table.remove(db, i)

                break
            end
        end

        for i, v in pairs(presets) do
            if v.name == name then
                return false
            end
        end

        database.write(protected.database.configs, db)
    end

    config_system.config_list = function()
        local database = database.read(protected.database.configs) or {}

        local config = {}

        for i, v in pairs(presets) do
            _G._G.table.insert(config, v.name)
        end

        for i, v in pairs(database) do
            _G._G.table.insert(config, v.name)
        end

        return config
    end

    config_system.load_settings = function(e, e2, e3)
        package:load(e)

        builder_package_t:load(e2)

        builder_package_ct:load(e3)
    end

    config_system.import_settings = function()
        local frombuffer = clipboard.get()

        local config = json.parse(base64.decode(frombuffer))

        config_system.load_settings(config.config, config.config2, config.config3)
    end

    config_system.export_settings = function(name)
        local config = {
            config = package:save(),
            config2 = builder_package_t:save(),
            config3 = builder_package_ct:save()
        }

        local toExport = base64.encode(json.stringify(config))

        clipboard.set(toExport)
    end

    config_system.get_export_blob = function()
        local config = {
            config = package:save(),
            config2 = builder_package_t:save(),
            config3 = builder_package_ct:save()
        }
        return base64.encode(json.stringify(config))
    end

    config_system.get_stored_export_blob = function(list_name)
        local fromDB = config_system.get(list_name)
        if not fromDB then
            return nil
        end
        local ok1, c1 = pcall(json.parse, base64.decode(fromDB.config))
        local ok2, c2 = pcall(json.parse, base64.decode(fromDB.config2))
        local ok3, c3 = pcall(json.parse, base64.decode(fromDB.config3))
        if not ok1 or not ok2 or not ok3 then
            return nil
        end
        return base64.encode(json.stringify({config = c1, config2 = c2, config3 = c3}))
    end

    config_system.import_payload = function(raw_b64)
        local decoded = json.parse(base64.decode(raw_b64))
        config_system.load_settings(decoded.config, decoded.config2, decoded.config3)
    end

    config_system.load = function(name)
        local fromDB = config_system.get(name)

        config_system.load_settings(
            json.parse(base64.decode(fromDB.config)),
            json.parse(base64.decode(fromDB.config2)),
            json.parse(base64.decode(fromDB.config3))
        )
    end

    local function cloud_base_trimmed()
        return CLOUD_DEFAULT_BASE
    end

    local function cloud_steam_display_name()
        local ok, n = pcall(function()
            return panorama.open("CSGOHud").MyPersonaAPI.GetName()
        end)
        if ok and type(n) == "string" then
            n = n:gsub("^%s+", ""):gsub("%s+$", "")
            if n ~= "" then
                return n
            end
        end
        local lp = entity.get_local_player()
        if lp then
            local ok2, nm = pcall(entity.get_player_name, lp)
            if ok2 and type(nm) == "string" then
                nm = nm:gsub("^%s+", ""):gsub("%s+$", "")
                if nm ~= "" then
                    return nm
                end
            end
        end
        return holder.utilities.get_username(holder.utilities)
    end

    local function cloud_sanitize_steam_tag(s)
        s = tostring(s or "")
        s = s:gsub("^%s+", ""):gsub("%s+$", "")
        s = s:gsub("[^%w%s%-]", "")
        s = s:gsub("%s+", " ")
        if s == "" then
            return "user"
        end
        if #s > 40 then
            s = s:sub(1, 40)
        end
        return s
    end

    local function cloud_config_base_only(raw)
        raw = raw:gsub("^%*", ""):gsub("^%s+", ""):gsub("%s+$", "")
        local before = raw:match("^(.-) %- .+$")
        if before and before ~= "" then
            return before:gsub("^%s+", ""):gsub("%s+$", "")
        end
        return raw
    end

    local function cloud_key_chars_ok(s)
        return s and s ~= "" and s:match("[^%w%s%-]") == nil and #s <= 120
    end

    local function cloud_profile_name_from_selected_list()
        local idx = holder.ui.menu.config_tab.list:get()
        if idx == nil then
            return nil, "select a profile in the profile list"
        end
        local i = idx + 1
        local raw
        if holder.ui.menu.config_tab.profile_source:get() == CONFIG_SOURCE_CLOUD then
            raw = cloud_config_names[i]
        else
            local L = config_system.config_list()
            raw = L and L[i] or nil
        end
        if raw == nil or raw == "" or raw:sub(1, 1) == "(" then
            return nil, "select a profile in the profile list (not a hint row)"
        end
        local name = raw:gsub("^%s+", ""):gsub("%s+$", "")
        if not cloud_key_chars_ok(name:gsub("^%*", "")) then
            return nil, "invalid profile name for cloud"
        end
        return name, nil
    end

    local function cloud_upload_key_from_local_list()
        if holder.ui.menu.config_tab.profile_source:get() ~= CONFIG_SOURCE_LOCAL then
            return nil, "switch to Local and select a profile to upload", nil
        end
        local idx = holder.ui.menu.config_tab.list:get()
        if idx == nil then
            return nil, "select a profile in the list", nil
        end
        local L = config_system.config_list()
        local raw = L and L[idx + 1] or nil
        if raw == nil or raw == "" or raw:sub(1, 1) == "(" then
            return nil, "select a profile in the local list (not a hint row)", nil
        end
        local base = cloud_config_base_only(raw)
        if base == "" or base:match("[^%w]") then
            return nil, "pick a profile whose base name uses only letters and digits", nil
        end
        local steam = cloud_sanitize_steam_tag(cloud_steam_display_name())
        local full = base .. " - " .. steam
        if not cloud_key_chars_ok(full) then
            return nil, "cloud key too long or bad characters (rename shorter?)", nil
        end
        return full, nil, raw
    end

    local function cloud_response_body(ok, response)
        if type(response) == "string" then
            return ok, response
        end
        if type(response) == "table" and type(response.body) == "string" then
            return ok, response.body
        end
        return ok, nil
    end

    local function cloud_fail_detail(label, ok, response)
        local bits = {label}
        if type(response) == "table" then
            if response.status ~= nil then
                bits[#bits + 1] = " HTTP "
                bits[#bits + 1] = tostring(response.status)
            end
            local b = response.body
            if type(b) == "string" and b ~= "" then
                if #b > 96 then
                    b = b:sub(1, 96) .. "…"
                end
                bits[#bits + 1] = " "
                bits[#bits + 1] = b
            end
        elseif not ok then
            bits[#bits + 1] = " (network)"
        end
        return table.concat(bits)
    end

    local function url_encode_segment(s)
        return (s:gsub("[^%w%-_.~]", function(c)
            return string.format("%%%02X", string.byte(c))
        end))
    end

    local function config_profile_source_is_cloud()
        return holder.ui.menu.config_tab.profile_source:get() == CONFIG_SOURCE_CLOUD
    end

    local function config_sync_listbox_to_source()
        if config_profile_source_is_cloud() then
            local names = cloud_config_names
            if #names == 0 then
                names = {"(Refresh cloud list)"}
            end
            holder.ui.menu.config_tab.list:update(names)
        else
            holder.ui.menu.config_tab.list:update(config_system.config_list())
        end
    end

    holder.ui.menu.config_tab.profile_source:set_callback(function()
        config_sync_listbox_to_source()
    end)

    holder.ui.menu.config_tab.list:set_callback(
        function(value)
            if value == nil then
                return
            end
            local idx = value:get() + 1
            if config_profile_source_is_cloud() then
                local n = cloud_config_names[idx]
                if n and n:sub(1, 1) ~= "(" then
                    holder.ui.menu.config_tab.name:set(n)
                end
            else
                local configs = config_system.config_list()
                if configs == nil then
                    return
                end
                holder.ui.menu.config_tab.name:set(configs[idx] or "name")
            end
        end
    )

    holder.ui.menu.config_tab.load:set_callback(
        function()
            if config_profile_source_is_cloud() then
                local base = cloud_base_trimmed()
                local name, err = cloud_profile_name_from_selected_list()
                if not name then
                    config_system.add(
                        {
                            holder.utilities.accent_color.first[1],
                            holder.utilities.accent_color.first[2],
                            holder.utilities.accent_color.first[3],
                            "essentials:"
                        },
                        {255, 120, 120, " " .. err}
                    )
                    return
                end
                client.exec("Play " .. "buttons/button9")
                http.get(
                    base .. "?name=" .. url_encode_segment(name),
                    {},
                    function(ok, response)
                        local _, bod = cloud_response_body(ok, response)
                        if bod == nil or bod == "" then
                            config_system.add(
                                {
                                    holder.utilities.accent_color.first[1],
                                    holder.utilities.accent_color.first[2],
                                    holder.utilities.accent_color.first[3],
                                    "essentials:"
                                },
                                {255, 120, 120, cloud_fail_detail(" download failed", ok, response)}
                            )
                            return
                        end
                        bod = bod:match("^%s*(.-)%s*$") or bod
                        local success, data = pcall(json.parse, bod)
                        if not success or not data or not data.payload then
                            local hint = ""
                            if bod and bod ~= "" then
                                hint = bod:sub(1, 72)
                                if #bod > 72 then
                                    hint = hint .. "…"
                                end
                                hint = " | " .. hint
                            end
                            config_system.add(
                                {
                                    holder.utilities.accent_color.first[1],
                                    holder.utilities.accent_color.first[2],
                                    holder.utilities.accent_color.first[3],
                                    "essentials:"
                                },
                                {255, 120, 120, " bad json (not a cloud save?)" .. hint}
                            )
                            return
                        end
                        local load_ok, err = pcall(config_system.import_payload, data.payload)
                        if load_ok then
                            holder.ui.menu.config_tab.profile_source:set(CONFIG_SOURCE_CLOUD)
                            config_sync_listbox_to_source()
                            config_system.add(
                                {
                                    holder.utilities.accent_color.first[1],
                                    holder.utilities.accent_color.first[2],
                                    holder.utilities.accent_color.first[3],
                                    "essentials:"
                                },
                                {225, 225, 225, " loaded " .. name}
                            )
                        else
                            config_system.add(
                                {
                                    holder.utilities.accent_color.first[1],
                                    holder.utilities.accent_color.first[2],
                                    holder.utilities.accent_color.first[3],
                                    "essentials:"
                                },
                                {255, 120, 120, " import error"}
                            )
                        end
                    end
                )
                return
            end

            local name = holder.ui.menu.config_tab.name:get()

            if name == "" then
                return
            end

            client.exec("Play " .. "buttons/button9")

            local s, p = pcall(config_system.load, name)

            if s then
                name = name:gsub("*", "")

                config_system.add(
                    {
                        holder.utilities.accent_color.first[1],
                        holder.utilities.accent_color.first[2],
                        holder.utilities.accent_color.first[3],
                        "essentials:"
                    },
                    {225, 225, 225, " "},
                    {225, 225, 225, "Configuration "},
                    {
                        holder.utilities.accent_color.first[1],
                        holder.utilities.accent_color.first[2],
                        holder.utilities.accent_color.first[3],
                        name
                    },
                    {225, 225, 225, " has been loaded"}
                )
            else
                config_system.add(
                    {
                        holder.utilities.accent_color.first[1],
                        holder.utilities.accent_color.first[2],
                        holder.utilities.accent_color.first[3],
                        "essentials:"
                    },
                    {225, 225, 225, " "},
                    {225, 225, 225, "Failed to load "},
                    {
                        holder.utilities.accent_color.first[1],
                        holder.utilities.accent_color.first[2],
                        holder.utilities.accent_color.first[3],
                        name
                    },
                    {225, 225, 225, ""}
                )
            end
        end
    )

    holder.ui.menu.config_tab.save:set_callback(
        function()
            local raw = holder.ui.menu.config_tab.name:get()

            if raw == "" then
                return
            end

            client.exec("Play " .. "buttons/button9")

            for i, v in pairs(presets) do
                if v.name:gsub("^%*", "") == cloud_config_base_only(raw:gsub("^%*", "")) then
                    return
                end
            end

            local base_only = cloud_config_base_only(raw:gsub("^%*", ""))
            if base_only == "" or base_only:match("[^%w]") then
                config_system.add(
                    {
                        holder.utilities.accent_color.first[1],
                        holder.utilities.accent_color.first[2],
                        holder.utilities.accent_color.first[3],
                        "essentials:"
                    },
                    {225, 225, 225, " "},
                    {225, 225, 225, "Use letters and digits only in the config name"}
                )
                return
            end

            local has_star = raw:match("^%*") ~= nil
            local name = base_only
            if has_star then
                name = "*" .. name
            end

            if name:match("[^%*%w%s%-]") ~= nil then
                config_system.add(
                    {
                        holder.utilities.accent_color.first[1],
                        holder.utilities.accent_color.first[2],
                        holder.utilities.accent_color.first[3],
                        "essentials:"
                    },
                    {225, 225, 225, " "},
                    {225, 225, 225, "Failed to save "},
                    {
                        holder.utilities.accent_color.first[1],
                        holder.utilities.accent_color.first[2],
                        holder.utilities.accent_color.first[3],
                        raw
                    }
                )

                return
            end

            local protected = function()
                config_system.save(name)

                holder.ui.menu.config_tab.list:update(config_system.config_list())
            end

            if pcall(protected) then
                holder.ui.menu.config_tab.name:set(name)
                config_system.add(
                    {
                        holder.utilities.accent_color.first[1],
                        holder.utilities.accent_color.first[2],
                        holder.utilities.accent_color.first[3],
                        "essentials:"
                    },
                    {225, 225, 225, " "},
                    {225, 225, 225, "Configuration "},
                    {
                        holder.utilities.accent_color.first[1],
                        holder.utilities.accent_color.first[2],
                        holder.utilities.accent_color.first[3],
                        name:gsub("^%*", "")
                    },
                    {225, 225, 225, " has been successfully saved"}
                )
            else
                config_system.add(
                    {
                        holder.utilities.accent_color.first[1],
                        holder.utilities.accent_color.first[2],
                        holder.utilities.accent_color.first[3],
                        "essentials:"
                    },
                    {225, 225, 225, " "},
                    {225, 225, 225, "Failed to save "},
                    {
                        holder.utilities.accent_color.first[1],
                        holder.utilities.accent_color.first[2],
                        holder.utilities.accent_color.first[3],
                        name
                    }
                )
            end
        end
    )

