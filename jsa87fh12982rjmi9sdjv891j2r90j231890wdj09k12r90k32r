local custom_scope_alpha = 0.0
local CUSTOM_SCOPE_RESOLUTION = 1 / 1080

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function motion_interp(a, b, duration)
    if duration == nil or duration <= 0 then
        return b
    end

    local dt = globals.frametime()
    if dt >= duration then
        return b
    end

    return a + (b - a) * (dt / duration)
end

