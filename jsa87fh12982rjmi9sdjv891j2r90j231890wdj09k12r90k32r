    end
    local enemies = entity.get_players(true)
    for i = 1, #enemies do
        local enemy = enemies[i]
        if entity.is_alive(enemy) and not entity.is_dormant(enemy) then
            local yaw = entity.get_prop(enemy, "m_angEyeAngles[1]")
            if yaw then
                local prev = aimbot_runtime.jitter_last_angles[enemy] or yaw
                local delta = normalize_angle(yaw - prev)
                local threshold = holder.ui.menu.aimbot_tab.other.jitter_correction_mode:get() == "Default" and 35 or 20
                if math.abs(delta) > threshold then
                    if plist and plist.set then
                        pcall(plist.set, enemy, "Force body yaw", true)
                        pcall(plist.set, enemy, "Force body yaw value", 0)
                    end
                end
                aimbot_runtime.jitter_last_angles[enemy] = yaw
            end
        end
    end
end

