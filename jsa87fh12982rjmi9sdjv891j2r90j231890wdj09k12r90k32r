local function viewmodel_pre_render()
    local vm = holder.ui.menu.visuals_tab.other.viewmodel
    if not vm then
        return
    end

    local enabled = vm.enabled:get()
    if not enabled then
        viewmodel_shutdown()
        return
    end

    local me = entity.get_local_player()
    if me == nil or not entity.is_alive(me) then
        return
    end

    local weapon = entity.get_player_weapon(me)
    if weapon == nil then
        return
    end

    local weapon_info = csgo_weapons(weapon)
    if weapon_info == nil then
        return
    end

    if not vm_state.applied then
        vm_state.original = {
            cl_bobup = cvar.cl_bobup:get_string(),
            cl_bobamt_lat = cvar.cl_bobamt_lat:get_string(),
            cl_bobamt_vert = cvar.cl_bobamt_vert:get_string(),
            viewmodel_fov = cvar.viewmodel_fov:get_string(),
            viewmodel_offset_x = cvar.viewmodel_offset_x:get_string(),
            viewmodel_offset_y = cvar.viewmodel_offset_y:get_string(),
            viewmodel_offset_z = cvar.viewmodel_offset_z:get_string(),
            cl_righthand = cvar.cl_righthand:get_string()
        }
        vm_state.applied = true
    end

    local options = vm.options
    local scope_down_sight = options:get('Scope down sight')
    local viewmodel_in_scope = options:get('Viewmodel in scope')
    local opposite_knife_hand = options:get('Opposite knife hand')

    local is_viewmodel_in_scope = scope_down_sight or viewmodel_in_scope

    local x = vm.offset_x:get() * 0.1
    local y = vm.offset_y:get() * 0.1
    local z = vm.offset_z:get() * 0.1

    if scope_down_sight then
        local is_scoped = entity.get_prop(me, 'm_bIsScoped') == 1
        vm_state.scope_value = motion_interp(vm_state.scope_value, is_scoped and 1 or 0, 0.05)

        x = lerp(x, -4.75, vm_state.scope_value)
        y = lerp(y, -5, vm_state.scope_value)
        z = lerp(z, -2, vm_state.scope_value)
    else
        vm_state.scope_value = 0.0
    end

    if is_viewmodel_in_scope then
        if weapon_info.raw and weapon_info.raw.hide_view_model_zoomed then
            weapon_info.raw.hide_view_model_zoomed = false
            if not vm_state.scope_unhide_cache_set[weapon_info.idx] then
                vm_state.scope_unhide_cache_set[weapon_info.idx] = true
                table.insert(vm_state.scope_unhide_cache, weapon_info.idx)
            end
        end
    else
        if #vm_state.scope_unhide_cache > 0 then
            for _, weapon_idx in ipairs(vm_state.scope_unhide_cache) do
                local wi = csgo_weapons[weapon_idx]
                if wi and wi.raw and wi.raw.hide_view_model_zoomed ~= nil then
                    wi.raw.hide_view_model_zoomed = true
                end
            end
            vm_state.scope_unhide_cache = {}
            vm_state.scope_unhide_cache_set = {}
        end
    end

    cvar.viewmodel_offset_x:set_raw_float(x)
    cvar.viewmodel_offset_y:set_raw_float(y)
    cvar.viewmodel_offset_z:set_raw_float(z)
    cvar.viewmodel_fov:set_raw_float(vm.fov:get() * 0.1)

    if opposite_knife_hand then
        if vm_state.last_weapon_idx ~= weapon_info.idx then
            vm_state.last_weapon_idx = weapon_info.idx
            local is_knife = weapon_info.type == 'knife'
            local is_right = cvar.cl_righthand:get_string() == '1'

            if is_right then
                cvar.cl_righthand:set_raw_int(is_knife and 0 or 1)
            else
                cvar.cl_righthand:set_raw_int(is_knife and 1 or 0)
            end
        end
    else
        if vm_state.original and vm_state.original.cl_righthand then
            cvar.cl_righthand:set_int(tonumber(vm_state.original.cl_righthand))
        end
        vm_state.last_weapon_idx = weapon_info.idx
    end
end

local function animfix_setup()
    local lp = entity.get_local_player()
    if not lp or not entity.is_alive(lp) then
        return
    end
    viewmodel_pre_render()
    if not holder.ui.menu.visuals_tab.other.animations_enable:get() then
        return
    end

    local self_index = c_entity.new(lp)
    local self_anim_state = self_index and self_index:get_anim_state() or nil
    local flags = entity.get_prop(lp, "m_fFlags") or 0
    local on_ground = bit.band(flags, 1) == 1
    local _, _, vel_z = entity.get_prop(lp, "m_vecVelocity")
    local in_air = not on_ground or (vel_z and math.abs(vel_z) > 8)
    local vel_x = entity.get_prop(lp, "m_vecVelocity[0]") or 0
    local vel_y = entity.get_prop(lp, "m_vecVelocity[1]") or 0
    local speed2d = math.sqrt(vel_x * vel_x + vel_y * vel_y)

    local POSE_STRAFE_YAW = 0
    local POSE_JUMP_FALL = 6
    local ground_mode = holder.ui.menu.visuals_tab.other.animations_ground_legs:get()
    local air_mode = holder.ui.menu.visuals_tab.other.animations_air_legs:get()
    local lean_mode = holder.ui.menu.visuals_tab.other.animations_move_lean:get()

    if not in_air then
        if ground_mode == "Disabled" then
            ui.set(holder.utilities.reference.aa_legs_movement[1], "Always slide")
        elseif ground_mode == "Static" then
            ui.set(holder.utilities.reference.aa_legs_movement[1], "Never slide")
            pcall(entity.set_prop, lp, "m_flPoseParameter", 0, POSE_STRAFE_YAW)
        elseif ground_mode == "Jitter" then
            ui.set(
                holder.utilities.reference.aa_legs_movement[1],
                globals.tickcount() % 4 > 1 and "Off" or "Always slide"
            )
            pcall(entity.set_prop, lp, "m_flPoseParameter", globals.tickcount() % 4 > 1 and 1 or 0.5, POSE_STRAFE_YAW)
        elseif ground_mode == "Random" then
            ui.set(
                holder.utilities.reference.aa_legs_movement[1],
                globals.tickcount() % 3 > 1 and "Off" or "Always slide"
            )
            pcall(entity.set_prop, lp, "m_flPoseParameter", client.random_float(0.1, 1), POSE_STRAFE_YAW)
        end
    else
        if air_mode == "Static" then
            pcall(entity.set_prop, lp, "m_flPoseParameter", 1, POSE_JUMP_FALL)
        elseif air_mode == "Jitter" then
            pcall(entity.set_prop, lp, "m_flPoseParameter", globals.tickcount() % 4 > 1 and 1 or 0, POSE_JUMP_FALL)
        else
            pcall(entity.set_prop, lp, "m_flPoseParameter", 0, POSE_JUMP_FALL)
        end
    end

    if speed2d >= 3 then
        local overlay = self_index and self_index:get_anim_overlay(12) or nil
        if overlay then
            if lean_mode == "No lean" then
                overlay.weight = 0
            elseif lean_mode == "Full lean" then
                overlay.weight = 1
            elseif lean_mode == "Random" then
                overlay.weight = client.random_float(0, 1)
            end
        end
    end

    if holder.ui.menu.visuals_tab.other.animations_landing_pitch:get() and self_anim_state and on_ground then
        if self_anim_state.hit_in_ground_animation then
            pcall(entity.set_prop, lp, "m_flPoseParameter", 0.5, 12)
        end
    end
end

local bind_alpha = {}

local function lerp_key(key, target, speed)
    speed = speed or 12
    local c = bind_alpha[key] or 0
    bind_alpha[key] = c + (target - c) * math.min(1, globals.frametime() * speed)
    return bind_alpha[key]
end

