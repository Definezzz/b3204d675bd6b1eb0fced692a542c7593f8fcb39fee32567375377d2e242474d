local function lerp(a, b, t)
    return a + (b - a) * t
end

local prediction_interp_presets = {[1] = 0.018, [2] = 0.026, [3] = 0.031}

local function prediction_calculate_lerp()
    local interp = cvar.cl_interp:get_float()
    local interp_ratio = cvar.cl_interp_ratio:get_float()
    return math.max(interp, interp_ratio * globals.tickinterval())
end

local function prediction_time_to_ticks(time)
    return math.floor(time / globals.tickinterval())
end

local function prediction_ticks_to_time(tick)
    return tick * globals.tickinterval()
end

local function prediction_compensate_lag(cmd)
    if not holder.ui.menu.aimbot_tab.other.prediction_enable:get() then
        return
    end
    local lerp_amt = prediction_calculate_lerp()
    local target_tick = globals.tickcount() - prediction_time_to_ticks(lerp_amt)
    local correct_time = holder.utilities.clamp(
        client.real_latency() + lerp_amt,
        0,
        cvar.sv_maxunlag:get_float()
    )
    if math.abs(correct_time - prediction_ticks_to_time(globals.tickcount() - target_tick)) > 0.2 then
        target_tick = globals.tickcount() - prediction_time_to_ticks(correct_time)
    end
    local lerp_remainder = math.fmod(client.real_latency(), globals.tickinterval())
    local real_target_time = prediction_ticks_to_time(target_tick)
    if lerp_remainder > 0 then
        real_target_time = real_target_time + globals.tickinterval() - lerp_remainder
    end
end

local function prediction_configure_client_interp()
    if not holder.ui.menu.aimbot_tab.other.prediction_enable:get() then
        cvar.cl_interp:set_float(0.001)
        return
    end
    local mode = holder.ui.menu.aimbot_tab.other.prediction_mode:get()
    local interp_value = prediction_interp_presets[mode]
    if interp_value then
        cvar.cl_interp:set_float(interp_value)
        if
            holder.ui.menu.aimbot_tab.other.prediction_indicator:get() and
                holder.ui.menu.aimbot_tab.other.prediction_hotkey:get()
         then
            renderer.indicator(255, 255, 255, 200, "PREDICTION")
        end
    end
    cvar.cl_interp_ratio:set_float(1)
    cvar.cl_interpolate:set_int(1)
end

local function update_aspect_ratio_smoothing()
    local menu = holder.ui.menu.visuals_tab.other
    if not menu.aspect_ratio:get() then
        client.set_cvar("r_aspectratio", 0)
        aspect_ratio_smooth = menu.aspect_ratio_value:get() / 100
        return
    end
    local target = menu.aspect_ratio_value:get() / 100
    if ("%.2f"):format(aspect_ratio_smooth) == ("%.2f"):format(target) then
        return
    end
    aspect_ratio_smooth = lerp(aspect_ratio_smooth, target, 0.05)
    client.set_cvar("r_aspectratio", aspect_ratio_smooth)
end

local hitlog_state = {
    notifications = {},
    backtrack = 0,
    wanted_damage = 0
}

local function hitlogs_frametime()
    return globals.frametime() * 8
end

local function format_name(entindex)
    if not entindex then
        return "unknown"
    end
    local ok, name = pcall(entity.get_player_name, entindex)
    if ok and name then
        return name
    end
    return "unknown"
end

local function screen_log(entry)
    if not entry then
        return
    end

    local text = entry.text
    if not text or text == "" then
        return
    end

    table.insert(
        hitlog_state.notifications,
        {
            string = text,
            icon = entry.icon or "",
            accent = entry.accent or {165, 207, 170},
            parts = entry.parts or nil,
            timer = 0,
            alpha = 0
        }
    )
end

local function on_aim_fire(e)
    hitlog_state.backtrack = globals.tickcount() - (e.tick or globals.tickcount())
    hitlog_state.wanted_damage = e.damage or 0
end

local function on_aim_hit(e)
    if not holder.ui.menu.visuals_tab.other.hit_logs.enabled:get() then
        return
    end
    if not holder.ui.menu.visuals_tab.other.hit_logs.filters:get("Hit") then
        return
    end

    local name = format_name(e.target)
    local hitgroup = hitgroup_names[(e.hitgroup or 0) + 1] or "?"
    local wanted_hitgroup = hitgroup_names[(e.hitgroup or 0) + 1] or "?"
    local damage = e.damage or 0
    local wanted_damage = hitlog_state.wanted_damage
    local hitchance = math.floor((e.hit_chance or 0) + 0.5)
    local backtrack = hitlog_state.backtrack

    local log_text =
        string.format(
        "Hit %s in %s(%s) for %d(%d) damage [ hitchance: %d | backtrack %d ]",
        name,
        hitgroup,
        wanted_hitgroup,
        damage,
        wanted_damage,
        hitchance,
        backtrack
    )

    if holder.ui.menu.visuals_tab.other.hit_logs.outputs:get("Console") then
        client.color_log(225, 225, 225, log_text)
    end

    if holder.ui.menu.visuals_tab.other.hit_logs.outputs:get("Screen") then
        client.color_log(225, 225, 225, log_text)
    end

    if holder.ui.menu.visuals_tab.other.hit_logs.outputs:get("Render") then
        screen_log(
            {
                icon = "✓",
                accent = {125, 220, 125},
                text = string.format("Hit %s in %s for %d dmg", name, hitgroup, damage),
                parts = {
                    {text = "Hit ", color = {230, 230, 230}},
                    {text = name, color = {125, 220, 125}},
                    {text = " in ", color = {230, 230, 230}},
                    {text = hitgroup, color = {125, 220, 125}},
                    {text = " for ", color = {230, 230, 230}},
                    {text = tostring(damage), color = {125, 220, 125}},
                    {text = " dmg", color = {230, 230, 230}}
                }
            }
        )
    end
end

local function on_aim_miss(e)
    if not holder.ui.menu.visuals_tab.other.hit_logs.enabled:get() then
        return
    end
    if not holder.ui.menu.visuals_tab.other.hit_logs.filters:get("Miss") then
        return
    end

    local name = format_name(e.target)
    local wanted_hitgroup = hitgroup_names[(e.hitgroup or 0) + 1] or "?"
    local wanted_damage = hitlog_state.wanted_damage
    local hitchance = math.floor((e.hit_chance or 0) + 0.5)
    local backtrack = hitlog_state.backtrack
    local reason = e.reason or "unknown"

    local log_text =
        string.format(
        "Missed shot due to %s at %s in the %s for %d damage [ hitchance: %d | backtrack %d ]",
