    local function manual_apply_settings()
        local yaw_value
        if holder.utilities.antiaim.manual_direction == 1 then
            yaw_value = -90
        elseif holder.utilities.antiaim.manual_direction == 2 then
            yaw_value = 90
        elseif holder.utilities.antiaim.manual_direction == 3 then
            yaw_value = -180
        end

        holder.utilities.antiaim.current_settings.yaw.mode = "180"
        holder.utilities.antiaim.current_settings.yaw.base = "Local view"
        holder.utilities.antiaim.current_settings.yaw.value = yaw_value
        holder.utilities.antiaim.current_settings.freestanding.enabled = false

        if holder.ui.menu.antiaim_tab.other.additional.yaw_mode.manual:get() ~= 1 then
            holder.utilities.antiaim.current_settings.pitch.mode = "Down"
            holder.utilities.antiaim.current_settings.yaw.modifier.mode = "Off"
            holder.utilities.antiaim.current_settings.yaw.modifier.value = 0
            holder.utilities.antiaim.current_settings.body_yaw.mode =
                holder.ui.menu.antiaim_tab.other.additional.yaw_mode.manual:get() == 2 and "Jitter" or "Static"
            holder.utilities.antiaim.current_settings.body_yaw.value = 60
        end
    end

    local function handle_manual()
        manual_direction()
        if holder.utilities.antiaim.manual_direction ~= 0 then
            manual_apply_settings()
        end
    end

    local function freestanding_check_active()
        local is_freestanding_disablers_enabled =
            holder.ui.menu.antiaim_tab.other.additional.select:get("Freestanding Disablers")
        local is_freestanding_active =
            holder.ui.menu.antiaim_tab.other.hotkey.freestanding:get() and
            holder.utilities.antiaim.manual_direction == 0

        if is_freestanding_disablers_enabled then
            local freestanding_disablers_active = false
            local disabled_states = holder.ui.menu.antiaim_tab.other.additional.freestanding.disablers_states:get()
            for _, state in ipairs(disabled_states) do
                if state == holder.utilities.antiaim.current_state then
                    freestanding_disablers_active = true
                    break
                end
            end
            if freestanding_disablers_active then
                is_freestanding_active = false
            end
        end
        return is_freestanding_active
    end

    local function freestanding_apply_settings(enabled)
        holder.utilities.antiaim.current_settings.freestanding.enabled = enabled
        if not enabled then
            return
        end
        if holder.ui.menu.antiaim_tab.other.additional.yaw_mode.freestanding:get() ~= 1 then
            holder.utilities.antiaim.current_settings.pitch.mode = "Down"
            holder.utilities.antiaim.current_settings.yaw.base = "At targets"
            holder.utilities.antiaim.current_settings.yaw.mode = "180"
            holder.utilities.antiaim.current_settings.yaw.value = 0
            holder.utilities.antiaim.current_settings.yaw.modifier.mode = "Off"
            holder.utilities.antiaim.current_settings.yaw.modifier.value = 0
            holder.utilities.antiaim.current_settings.body_yaw.mode =
                holder.ui.menu.antiaim_tab.other.additional.yaw_mode.freestanding:get() == 2 and "Jitter" or "Static"
            holder.utilities.antiaim.current_settings.body_yaw.value = 60
        end
    end

    local function handle_freestanding()
        freestanding_apply_settings(freestanding_check_active())
    end

    local function safe_head_check_active()
        if not holder.ui.menu.antiaim_tab.other.additional.select:get("Safe Head") then
            return false
        end
        local lp = entity.get_local_player()
        local weapon = entity.get_player_weapon(lp)
        if not weapon then
            return false
        end
        local players = entity.get_players(true)
        local lp_origin = vector(entity.get_prop(lp, "m_vecOrigin"))
        local closest_enemy = nil
        local min_distance = math.huge

        for i = 1, #players do
            local enemy = players[i]
            local enemy_origin = vector(entity.get_prop(enemy, "m_vecOrigin"))
            local distance = lp_origin:dist(enemy_origin)
            if distance < min_distance then
                min_distance = distance
                closest_enemy = enemy
            end
        end

        local threat_origin = vector(entity.get_prop(closest_enemy, "m_vecOrigin"))
        local height_difference = lp_origin.z - threat_origin.z
        local state_index = holder.utilities.antiaim.state_index
        local is_knife = entity.get_classname(weapon) == "CKnife"
        local is_taser = entity.get_classname(weapon) == "CWeaponTaser"
        local height_diff_threshold = holder.ui.menu.antiaim_tab.other.additional.safe_head.height_difference:get()
        local is_above_enemy = height_difference > height_diff_threshold and closest_enemy ~= nil
        local knife_condition =
            holder.ui.menu.antiaim_tab.other.additional.safe_head.states:get("Knife") and state_index == 6 and is_knife
        local taser_condition =
            holder.ui.menu.antiaim_tab.other.additional.safe_head.states:get("Taser") and state_index == 6 and is_taser
        local above_condition =
            holder.ui.menu.antiaim_tab.other.additional.safe_head.states:get("Above enemy") and is_above_enemy
        return knife_condition or taser_condition or above_condition
    end

    local function safe_head_apply_settings()
        holder.utilities.antiaim.current_settings.pitch.mode = "Down"
        holder.utilities.antiaim.current_settings.yaw.mode = "180"
        holder.utilities.antiaim.current_settings.yaw.value = 0
        holder.utilities.antiaim.current_settings.yaw.modifier.mode = "Off"
        holder.utilities.antiaim.current_settings.yaw.modifier.value = 0
        holder.utilities.antiaim.current_settings.body_yaw.mode = "Static"
        holder.utilities.antiaim.current_settings.body_yaw.value = 0
        holder.utilities.antiaim.current_settings.freestanding.enabled = false
    end

    local function handle_safe_head()
        if safe_head_check_active() then
            safe_head_apply_settings()
        end
    end

    function holder.utilities.antiaim.update_settings(cmd, state_index, team)
        local settings =
            (team == "T") and holder.ui.antiaim_states_t[state_index] or holder.ui.antiaim_states_ct[state_index]
        local yaw_random_percent = settings.yaw.randomize_value:get() * 0.01
        local jitter_random_percent = settings.yaw.modifier.randomize_value:get() * 0.01
        local tick = globals.tickcount()
        local time = globals.curtime()

        local pitch_mode = settings.pitch.mode:get()
        holder.utilities.antiaim.current_settings.pitch.mode = "Down"
        holder.utilities.antiaim.current_settings.pitch.value = 0
        if pitch_mode == "Static" then
            holder.utilities.antiaim.current_settings.pitch.mode = "Custom"
            holder.utilities.antiaim.current_settings.pitch.value = settings.pitch.value:get()
        elseif pitch_mode == "Sway" then
            local speed = math.max(1, math.abs(settings.yaw.delay.first_value:get()))
            holder.utilities.antiaim.current_settings.pitch.mode = "Custom"
            holder.utilities.antiaim.current_settings.pitch.value =
                math.floor(math.sin(time * speed) * math.abs(settings.pitch.value:get()))
        elseif pitch_mode == "Switch" then
            local delay = math.max(1, settings.yaw.delay.value:get())
            local sign = (math.floor(tick / delay) % 2 == 0) and 1 or -1
            holder.utilities.antiaim.current_settings.pitch.mode = "Custom"
            holder.utilities.antiaim.current_settings.pitch.value = settings.pitch.value:get() * sign
        elseif pitch_mode == "Random" then
            holder.utilities.antiaim.current_settings.pitch.mode = "Custom"
            holder.utilities.antiaim.current_settings.pitch.value = client.random_int(-89, 89)
        elseif pitch_mode == "Static Random" then
            local value = settings.pitch.value:get()
            holder.utilities.antiaim.current_settings.pitch.mode = "Custom"
            holder.utilities.antiaim.current_settings.pitch.value = client.random_int(-math.abs(value), math.abs(value))
        end

        holder.utilities.antiaim.current_settings.yaw.base = settings.yaw.base:get()
        local yaw_mode = settings.yaw.mode:get()
        local yaw_offset = settings.yaw.value:get()
        local left = settings.yaw.left_value:get()
        local right = settings.yaw.right_value:get()
        if settings.yaw.crouchwalk_store and cmd then
            local fwd = (cmd.forwardmove or 0)
            local side = (cmd.sidemove or 0)
            local move_dir
            if math.abs(fwd) >= math.abs(side) then
                move_dir = fwd >= 0 and "Forward" or "Backward"
            else
                move_dir = side >= 0 and "Right" or "Left"
            end

            local store = settings.yaw.crouchwalk_store[move_dir]
            if store and store.left and store.right then
                left = store.left:get()
                right = store.right:get()
            end
        end
        local random_left = math.abs(left) * yaw_random_percent
        local random_right = math.abs(right) * yaw_random_percent
        left = left + client.random_int(-random_left, random_left)
        right = right + client.random_int(-random_right, random_right)
        local yaw_result = yaw_offset
        local body_mode = settings.body_yaw.mode:get()

        if yaw_mode == "Off" then
            holder.utilities.antiaim.current_settings.yaw.mode = "180"
            yaw_result = 0
        elseif yaw_mode == "Side Based" then
            holder.utilities.antiaim.current_settings.yaw.mode = "180"
            yaw_result = holder.utilities.antiaim.jitter_inverter and left or right
        elseif yaw_mode == "Opposite" then
            holder.utilities.antiaim.current_settings.yaw.mode = "180"
            yaw_result = 180 + yaw_offset
        elseif yaw_mode == "Spin" then
            holder.utilities.antiaim.current_settings.yaw.mode = "Spin"
            yaw_result = yaw_offset
        elseif yaw_mode == "Sway" then
            holder.utilities.antiaim.current_settings.yaw.mode = "180"
            yaw_result = math.floor(math.sin(time * 5) * 60) + yaw_offset
        elseif yaw_mode == "X-Way" then
            holder.utilities.antiaim.current_settings.yaw.mode = "180"
            local cycle = {left, -left, right, -right}
            yaw_result = cycle[(tick % #cycle) + 1]
        elseif yaw_mode == "Random" then
            holder.utilities.antiaim.current_settings.yaw.mode = "180"
            yaw_result = client.random_int(-180, 180)
        elseif yaw_mode == "Static Random" then
            holder.utilities.antiaim.current_settings.yaw.mode = "180"
            local max_value = math.max(math.abs(left), math.abs(right), math.abs(yaw_offset))
            yaw_result = client.random_int(-max_value, max_value)
        else
            holder.utilities.antiaim.current_settings.yaw.mode = "Left/Right"
        end

        holder.utilities.antiaim.current_settings.yaw.value = normalize_yaw(yaw_result)
        holder.utilities.antiaim.current_settings.yaw.left_value = normalize_yaw(left)
        holder.utilities.antiaim.current_settings.yaw.right_value = normalize_yaw(right)
        holder.utilities.antiaim.current_settings.yaw.modifier.mode = settings.yaw.modifier.mode:get()
        local jitter_offset = settings.yaw.modifier.value:get()
        if holder.utilities.antiaim.current_settings.yaw.modifier.mode ~= "Off" then
            local random_jitter = math.abs(jitter_offset) * jitter_random_percent
            jitter_offset = jitter_offset + client.random_int(-random_jitter, random_jitter)
        end
        holder.utilities.antiaim.current_settings.yaw.modifier.value = normalize_yaw(jitter_offset)
        holder.utilities.antiaim.current_settings.body_yaw.mode = body_mode
        holder.utilities.antiaim.current_settings.body_yaw.value = settings.body_yaw.value:get()
        holder.utilities.antiaim.current_settings.body_yaw.inverter = settings.body_yaw.inverter:get()
        holder.utilities.antiaim.current_settings.body_yaw.left_value = settings.body_yaw.left_value:get()
        holder.utilities.antiaim.current_settings.body_yaw.right_value = settings.body_yaw.right_value:get()

        local should_switch = false
        local delay = 1
        if yaw_mode == "Left/Right" or yaw_mode == "Side Based" then

            if settings.yaw.delay.mode:get() == 1 then
                if globals.tickcount() > holder.utilities.antiaim.jitter_last_tick + 1 then
                    if cmd.chokedcommands == 0 then
                        should_switch = true
                        delay = 1
                    end
                end
            elseif settings.yaw.delay.mode:get() == 2 then
                if globals.tickcount() > holder.utilities.antiaim.jitter_last_tick + settings.yaw.delay.value:get() then
                    if cmd.chokedcommands == 0 then
                        should_switch = true
                        delay = settings.yaw.delay.value:get() or 1
                    end
                end
            elseif settings.yaw.delay.mode:get() == 3 then
                local first_delay = settings.yaw.delay.first_value:get() or 1
                local second_delay = settings.yaw.delay.second_value:get() or 1
                if
                    globals.tickcount() >
                        holder.utilities.antiaim.jitter_last_tick + math.random(first_delay, second_delay)
                 then
                    if cmd.chokedcommands == 0 then
                        should_switch = true
                        delay = math.random(first_delay, second_delay)
                    end
                end
            elseif settings.yaw.delay.mode:get() == 4 then
                delay = get_next_custom_delay(settings) or 1

                local additional_delay = 0
                if settings.yaw.delay.custom.mode:get() == 1 then
                    additional_delay = 1
                end

                if globals.tickcount() > holder.utilities.antiaim.jitter_last_tick + delay + additional_delay then
                    if cmd.chokedcommands == 0 then
                        should_switch = true
                    end
                end
            end

        else
            local delay_from = math.max(1, settings.yaw.delay.value:get() or 1)
            local delay_to = math.max(delay_from, settings.yaw.delay.first_value:get() or delay_from)
            delay = client.random_int(delay_from, delay_to)
            if cmd and cmd.chokedcommands == 0 and tick > holder.utilities.antiaim.jitter_last_tick + delay then
                should_switch = true
            end
        end

        if should_switch then
            local should_invert = true
            if body_mode == "Jitter Random" then
                should_invert = client.random_int(0, 1) == 0
            end
            if should_invert then
                holder.utilities.antiaim.jitter_inverter = not holder.utilities.antiaim.jitter_inverter
            end
            holder.utilities.antiaim.jitter_last_tick = globals.tickcount()

            if settings.yaw.delay.mode:get() == 4 and settings.yaw.delay.custom.mode:get() == 1 then
                holder.utilities.antiaim.custom_delay_index =
                    holder.utilities.antiaim.custom_delay_index % settings.yaw.delay.custom.count:get() + 1
            end

            table.insert(
                holder.utilities.antiaim.custom_delay_history,
                {
                    delay = delay,
                    state = holder.utilities.antiaim.jitter_inverter,
                    time = globals.curtime()
                }
            )

            if #holder.utilities.antiaim.custom_delay_history > 20 then
                table.remove(holder.utilities.antiaim.custom_delay_history, 1)
            end
        end

        if yaw_mode == "Left/Right" or yaw_mode == "Side Based" then
            holder.utilities.antiaim.current_settings.yaw.value =
                holder.utilities.antiaim.jitter_inverter and
                holder.utilities.antiaim.current_settings.yaw.left_value or
                holder.utilities.antiaim.current_settings.yaw.right_value
            holder.utilities.antiaim.current_settings.yaw.mode = "180"
        end

        local jitter_mode = holder.utilities.antiaim.current_settings.yaw.modifier.mode
        local jitter_value = holder.utilities.antiaim.current_settings.yaw.modifier.value
        if jitter_mode == "Offset" then
            holder.utilities.antiaim.current_settings.yaw.value =
                normalize_yaw(holder.utilities.antiaim.current_settings.yaw.value + (holder.utilities.antiaim.jitter_inverter and jitter_value or 0))
            holder.utilities.antiaim.current_settings.yaw.modifier.mode = "Off"
            holder.utilities.antiaim.current_settings.yaw.modifier.value = 0
        elseif jitter_mode == "Center" then
            local centered = holder.utilities.antiaim.jitter_inverter and (jitter_value / 2) or (-jitter_value / 2)
            holder.utilities.antiaim.current_settings.yaw.value =
                normalize_yaw(holder.utilities.antiaim.current_settings.yaw.value + centered)
            holder.utilities.antiaim.current_settings.yaw.modifier.mode = "Off"
            holder.utilities.antiaim.current_settings.yaw.modifier.value = 0
        elseif jitter_mode == "Skitter" then
            local skitter = {1, -1, 0.5, -0.5}
            local mult = skitter[(#holder.utilities.antiaim.custom_delay_history % #skitter) + 1]
            holder.utilities.antiaim.current_settings.yaw.value =
                normalize_yaw(holder.utilities.antiaim.current_settings.yaw.value + (jitter_value * mult))
            holder.utilities.antiaim.current_settings.yaw.modifier.mode = "Off"
            holder.utilities.antiaim.current_settings.yaw.modifier.value = 0
        end

        if holder.utilities.antiaim.current_settings.body_yaw.mode == "Jitter" then
            local offset = holder.utilities.antiaim.current_settings.body_yaw.value
            if offset == 0 then
                offset = 1
            end
            holder.utilities.antiaim.current_settings.body_yaw.mode = "Static"
            holder.utilities.antiaim.current_settings.body_yaw.value =
                holder.utilities.antiaim.jitter_inverter and offset or -offset
        elseif holder.utilities.antiaim.current_settings.body_yaw.mode == "Jitter Random" then
            local offset = holder.utilities.antiaim.current_settings.body_yaw.value
            if offset == 0 then
                offset = 1
            end
            holder.utilities.antiaim.current_settings.body_yaw.mode = "Static"
            holder.utilities.antiaim.current_settings.body_yaw.value =
                holder.utilities.antiaim.jitter_inverter and offset or -offset
        end
        if
            holder.utilities.antiaim.current_settings.body_yaw.mode ~= "Off" and
                holder.utilities.antiaim.current_settings.body_yaw.mode ~= "Opposite" and
                holder.utilities.antiaim.current_settings.body_yaw.mode ~= "Static" and
                holder.utilities.antiaim.current_settings.body_yaw.mode ~= "Jitter"
         then
            holder.utilities.antiaim.current_settings.body_yaw.mode = "Off"
            holder.utilities.antiaim.current_settings.body_yaw.value = 0
        end
    end

    function holder.utilities.antiaim.apply_all_settings()
        ui.set(holder.utilities.reference.aa_pitch[1], holder.utilities.antiaim.current_settings.pitch.mode)
        ui.set(holder.utilities.reference.aa_pitch[2], holder.utilities.antiaim.current_settings.pitch.value)

        ui.set(holder.utilities.reference.aa_yaw_base, holder.utilities.antiaim.current_settings.yaw.base)
        if holder.utilities.antiaim.current_settings.yaw.mode == "Left/Right" then
            ui.set(holder.utilities.reference.aa_yaw[1], "180")
            local yaw_value
            if holder.utilities.antiaim.jitter_inverter then
                yaw_value = holder.utilities.antiaim.current_settings.yaw.left_value
            else
                yaw_value = holder.utilities.antiaim.current_settings.yaw.right_value
            end
            ui.set(holder.utilities.reference.aa_yaw[2], yaw_value)
        elseif
            holder.utilities.antiaim.current_settings.yaw.mode == "180" or
                holder.utilities.antiaim.current_settings.yaw.mode == "Spin"
         then
            ui.set(holder.utilities.reference.aa_yaw[1], holder.utilities.antiaim.current_settings.yaw.mode)
            ui.set(holder.utilities.reference.aa_yaw[2], holder.utilities.antiaim.current_settings.yaw.value)
        else
            ui.set(holder.utilities.reference.aa_yaw[1], "180")
            ui.set(holder.utilities.reference.aa_yaw[2], holder.utilities.antiaim.current_settings.yaw.value)
        end

        ui.set(holder.utilities.reference.aa_yaw_jitter[1], holder.utilities.antiaim.current_settings.yaw.modifier.mode)
        ui.set(
            holder.utilities.reference.aa_yaw_jitter[2],
            holder.utilities.antiaim.current_settings.yaw.modifier.value
        )
        ui.set(holder.utilities.reference.aa_yaw_body[1], holder.utilities.antiaim.current_settings.body_yaw.mode)
        ui.set(holder.utilities.reference.aa_yaw_body[2], holder.utilities.antiaim.current_settings.body_yaw.value)
        ui.set(
            holder.utilities.reference.aa_freestanding[1],
            holder.utilities.antiaim.current_settings.freestanding.enabled
        )
        ui.set(
            holder.utilities.reference.aa_freestanding[2],
            holder.utilities.antiaim.current_settings.freestanding.enabled and "Always on" or "On hotkey"
        )
        ui.set(
            holder.utilities.reference.aa_fakelag_enabled[1],
            holder.utilities.antiaim.current_settings.fakelag.enabled
        )
        ui.set(
            holder.utilities.reference.aa_fakelag_amount[1],
            holder.utilities.antiaim.current_settings.fakelag.amount
        )
        ui.set(holder.utilities.reference.aa_fakelag_limit[1], holder.utilities.antiaim.current_settings.fakelag.limit)
        ui.set(
            holder.utilities.reference.aa_fakelag_variance[1],
            holder.utilities.antiaim.current_settings.fakelag.variance
        )
    end

    function holder.utilities.antiaim.update_fakelag_settings()
        holder.utilities.antiaim.current_settings.fakelag.enabled =
            holder.ui.menu.antiaim_tab.other.fakelag.enabled:get()
        holder.utilities.antiaim.current_settings.fakelag.amount = holder.ui.menu.antiaim_tab.other.fakelag.amount:get()
        holder.utilities.antiaim.current_settings.fakelag.limit = holder.ui.menu.antiaim_tab.other.fakelag.limit:get()
        if holder.ui.menu.antiaim_tab.other.fakelag.variance.randomize:get() > 0 then
            holder.utilities.antiaim.current_settings.fakelag.variance =
                math.random(
                holder.ui.menu.antiaim_tab.other.fakelag.variance.randomize:get(),
                holder.ui.menu.antiaim_tab.other.fakelag.variance.amount:get()
            )
        else
            holder.utilities.antiaim.current_settings.fakelag.variance =
                holder.ui.menu.antiaim_tab.other.fakelag.variance.amount:get()
        end
    end

    function holder.utilities.antiaim.handle_antiaim(cmd)
        local lp = entity.get_local_player()
        if not lp or not entity.is_alive(lp) then
            return
        end
        holder.utilities.antiaim.current_state = holder.utilities.antiaim.get_player_state(cmd)
        holder.utilities.antiaim.current_team = entity.get_prop(lp, "m_iTeamNum") == 2 and "T" or "CT"
        holder.utilities.antiaim.state_index = 1
        for i, state in ipairs(holder.utilities.antiaim.states) do
            if state == holder.utilities.antiaim.current_state then
                holder.utilities.antiaim.state_index = i
                break
            end
        end
        holder.utilities.antiaim.defensive_state_index = holder.utilities.antiaim.state_index

        if holder.utilities.antiaim.state_index ~= 1 then
            local settings_table =
                (holder.utilities.antiaim.current_team == "T") and holder.ui.antiaim_states_t or
                holder.ui.antiaim_states_ct
            local current_state_settings = settings_table[holder.utilities.antiaim.state_index]
            if not current_state_settings.override_state:get() then
                holder.utilities.antiaim.state_index = 1
            end
        end

        holder.utilities.antiaim.update_settings(
            cmd,
            holder.utilities.antiaim.state_index,
            holder.utilities.antiaim.current_team
        )
        holder.utilities.antiaim.update_fakelag_settings()
        handle_freestanding()
        handle_manual()
        handle_safe_head()
        handle_avoid_backstab()
        handle_fast_ladder(cmd)
        apply_defensive_antiaim(cmd)
        apply_defensive_flick(cmd)

        holder.utilities.antiaim.apply_all_settings()
        apply_defensive_flick_after_apply(cmd)
    end
end

