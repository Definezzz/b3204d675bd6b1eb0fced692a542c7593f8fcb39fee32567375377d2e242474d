local function custom_scope_draw_gradient(x, y, w, h, r1, g1, b1, a1, r2, g2, b2, a2, horizontal, start_fade)
    local fade = (start_fade or 50) * 0.01 * 2
    if fade <= 0 then
        fade = 0.01
    end

    if horizontal then
        local half_w = math.floor(w * fade * 0.5)
        renderer.gradient(x, y, half_w, h, r2, g2, b2, a2, r1, g1, b1, a1, true)
        renderer.gradient(x + half_w, y, w - half_w, h, r1, g1, b1, a1, r2, g2, b2, a2, true)
    else
        local half_h = math.floor(h * fade * 0.5)
        renderer.gradient(x, y, w, half_h, r2, g2, b2, a2, r1, g1, b1, a1, false)
        renderer.gradient(x, y + half_h, w, h - half_h, r1, g1, b1, a1, r2, g2, b2, a2, false)
    end
end

local function custom_scope_paint_ui()
    local cs = holder.ui.menu.visuals_tab.other.custom_scope
    if not cs or not cs.enabled:get() then
        return
    end

    set_scope_overlay(true)

    local me = entity.get_local_player()
    if me == nil or not entity.is_alive(me) then
        return
    end

    local is_scoped = entity.get_prop(me, 'm_bIsScoped') == 1
    local anim_speed = cs.animation_speed:get()
    if anim_speed <= 0 then
        anim_speed = 1
    end

    custom_scope_alpha = motion_interp(custom_scope_alpha, is_scoped and 1 or 0, 1 / anim_speed)
    if custom_scope_alpha <= 0.001 then
        return
    end

    local sx, sy = client.screen_size()
    local center_x = sx * 0.5
    local center_y = sy * 0.5

    local start_fade = cs.start_fade:get()

    local r, g, b = r3 or 165, g3 or 207, b3 or 170
    local base_a = 200
    local a = math.floor(base_a * custom_scope_alpha)

    local offset = math.floor(cs.offset:get() * sy * CUSTOM_SCOPE_RESOLUTION)
    local position = math.floor(cs.position:get() * sy * CUSTOM_SCOPE_RESOLUTION)
    local delta = position - offset

    local ar, ag, ab, aa = r, g, b, a
    local br, bg, bb, ba = r, g, b, 0

    renderer.gradient(center_x, center_y - offset + 1, 1, -delta, ar, ag, ab, aa, br, bg, bb, ba, false)
    renderer.gradient(center_x, center_y + offset, 1, delta, ar, ag, ab, aa, br, bg, bb, ba, false)
    renderer.gradient(center_x - offset + 1, center_y, -delta, 1, ar, ag, ab, aa, br, bg, bb, ba, true)
    renderer.gradient(center_x + offset, center_y, delta, 1, ar, ag, ab, aa, br, bg, bb, ba, true)
end

