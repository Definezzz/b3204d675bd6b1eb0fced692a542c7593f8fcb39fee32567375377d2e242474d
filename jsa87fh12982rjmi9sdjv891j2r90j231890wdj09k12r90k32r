local function atg_is_peeking()
    local me = entity.get_local_player()
    if not me then
        return false
    end
    local enemies = entity.get_players(true)
    if not enemies then
        return false
    end

    local predict_amt = 0.25
    local ex, ey, ez = client.eye_position()
    local lvx, lvy, lvz = entity.get_prop(me, "m_vecVelocity")
    if not ex then
        return false
    end

    local pex = ex + (lvx or 0) * predict_amt
    local pey = ey + (lvy or 0) * predict_amt
    local pez = ez + (lvz or 0) * predict_amt

    for i = 1, #enemies do
        local e = enemies[i]
        if entity.is_alive(e) and not entity.is_dormant(e) then
            local evx, evy, evz = entity.get_prop(e, "m_vecVelocity")
            local hx, hy, hz = entity.hitbox_position(e, 0)
            if hx then
                local phx = hx + (evx or 0) * predict_amt
                local phy = hy + (evy or 0) * predict_amt
                local phz = hz + (evz or 0) * predict_amt
                local _, damage = client.trace_bullet(me, pex, pey, pez, phx, phy, phz)
                if damage and damage > 0 then
                    return true
                end
            end
        end
    end
    return false
end

local function get_freestand_direction()
    local me = entity.get_local_player()
    if not me then
        return 1
    end
    local lx, ly = entity.get_prop(me, "m_vecOrigin")
    if not lx then
        return 1
    end
    local view_yaw = select(2, client.camera_angles())
    local enemies = entity.get_players(true)
    local best_dist = math.huge
    local best_delta = 0
    for i = 1, #enemies do
        local e = enemies[i]
        if entity.is_alive(e) and not entity.is_dormant(e) then
            local ex, ey = entity.get_prop(e, "m_vecOrigin")
            if ex then
                local dx, dy = ex - lx, ey - ly
                local dist = math.sqrt(dx * dx + dy * dy)
                if dist < best_dist then
                    best_dist = dist
                    local yaw_to_enemy = math.deg(math.atan2(dy, dx))
                    best_delta = normalize_angle(yaw_to_enemy - view_yaw)
                end
            end
        end
    end
    return best_delta >= 0 and 1 or -1
end

local function get_defensive_direction(cmd)
