apply_defensive_antiaim = function(cmd)
    local settings_table =
        (holder.utilities.antiaim.current_team == "T") and holder.ui.antiaim_states_t or holder.ui.antiaim_states_ct
    local defensive_idx = holder.utilities.antiaim.defensive_state_index or holder.utilities.antiaim.state_index
    local state_cfg = settings_table and settings_table[defensive_idx]
    if not state_cfg or not state_cfg.defensive then
        return
    end
    local d = state_cfg.defensive
    local mode = d.mode:get()
    if mode == "Off" then
        return
    end

    local is_exploit_active = (rage_double_tap_active() or rage_on_shot_antiaim_active())
    if not is_exploit_active then
        if cmd then
            pcall(
                function()
                    cmd.force_defensive = false
                end
            )
        end
        return
    end
    local ticks = get_defensive_ticks()
    -- Some setups never expose reliable "ticks" (or on-shot), so we don't hard-block here.
    -- We still prefer ticks > 0 when available.

    local should_apply = false

    if mode == "Always" then
        should_apply = true
    elseif mode == "On Peek" then
        should_apply = atg_is_peeking()
    elseif mode == "Flick" then
        should_apply = cmd and (cmd.command_number % 7 == 0) or false
    end

    if not should_apply then
        if cmd then
            pcall(
                function()
                    cmd.force_defensive = false
                end
            )
        end
        return
    end

    if cmd then
        pcall(function()
            local want_force = false
            if d.force_defensive ~= nil and type(d.force_defensive.get) == "function" then
                local ok, v = pcall(function()
                    return d.force_defensive:get()
                end)
                if ok then
                    want_force = v and true or false
                end
            else
                -- backwards-compat if config doesn't have the checkbox
                want_force = true
            end
            cmd.force_defensive = want_force and true or false
        end)
        if mode == "On Peek" then
            pcall(
                function()
                    cmd.allow_send_packet = false
                end
            )
        end
    end
    if not d.antiaim_on:get() then
        return
    end

    if mode == "On Peek" then
        holder.utilities.antiaim.current_settings.freestanding.enabled = false
    end
    holder.utilities.antiaim.current_settings.yaw.base = "Local view"
    local pitch = d.pitch_mode:get()
    if pitch == "Default" then
        holder.utilities.antiaim.current_settings.pitch.mode = "Custom"
        holder.utilities.antiaim.current_settings.pitch.value = d.pitch_value:get()
    else
        holder.utilities.antiaim.current_settings.pitch.mode = "Custom"
        holder.utilities.antiaim.current_settings.pitch.value =
            client.random_int(-math.abs(d.pitch_value:get()), math.abs(d.pitch_value:get()))
    end

    holder.utilities.antiaim.current_settings.yaw.mode = "180"
    holder.utilities.antiaim.current_settings.yaw.modifier.mode = "Off"
    holder.utilities.antiaim.current_settings.yaw.modifier.value = 0
    holder.utilities.antiaim.current_settings.body_yaw.mode = "Off"
    holder.utilities.antiaim.current_settings.body_yaw.value = 0

    local fs_active = holder.ui.menu.antiaim_tab.other.hotkey.freestanding:get() and holder.utilities.antiaim.manual_direction == 0
    local direction = fs_active and get_defensive_direction(cmd) or 1
    local yaw = direction * d.yaw_value:get()
    local slide = d.yaw_modifier_slide:get()
    if d.yaw_modifier:get("Offset") then
        yaw = yaw + (globals.tickcount() % 4 > 1 and direction * slide or -direction * slide)
    end
    if d.yaw_modifier:get("Center") then
        yaw = (globals.tickcount() % 2 == 0 and direction * slide or -direction * slide)
    end
    if d.yaw_modifier:get("Random") then
        yaw = yaw + direction * client.random_int(-slide, slide)
    end
    if d.yaw_modifier:get("Spin") then
        yaw = normalize_angle(globals.curtime() * math.max(1, slide) * 18)
    end
    holder.utilities.antiaim.current_settings.yaw.value = normalize_angle(yaw)
end

