    ticks = 0
}

local function normalize_angle(angle)
    while angle > 180 do
        angle = angle - 360
    end
    while angle < -180 do
        angle = angle + 360
    end
    return angle
end

local function get_defensive_ticks()
    local me = entity.get_local_player()
    if not me then
        atg_exploit.max_tickbase = 0
        atg_exploit.ticks = 0
        return 0
    end
    local tickbase = entity.get_prop(me, "m_nTickBase")
    if not tickbase then
        return 0
    end

    if math.abs(tickbase - atg_exploit.max_tickbase) > 64 then
        atg_exploit.max_tickbase = 0
    end

    if tickbase > atg_exploit.max_tickbase then
        atg_exploit.max_tickbase = tickbase
    elseif atg_exploit.max_tickbase > tickbase then
        atg_exploit.ticks = math.min(14, math.max(0, atg_exploit.max_tickbase - tickbase - 1))
    else
        atg_exploit.ticks = 0
    end

    return atg_exploit.ticks
end

