            local x1, y1, x2, y2, alpha = entity.get_bounding_box(player)
            if x1 and alpha and alpha > 0 then
                local hx, hy, hz = entity.hitbox_position(player, 0)
                if hx and hy and hz then
                    local _, damage = client.trace_bullet(lp, ex, ey, ez, hx, hy, hz)
                    if damage and damage >= min_damage and damage > best_damage then
                        best_damage = damage
                        best_target = {x = hx, y = hy, z = hz}
                    end
                end
            end
        end
    end

    if best_target and best_damage > 0 then
        local pitch, yaw = vector(ex, ey, ez):to(vector(best_target.x, best_target.y, best_target.z)):angles()
        cmd.viewangles = {pitch, yaw}
        cmd.in_attack = 1
    end
end

