local trashtalk_queue = {}

local function schedule_trashtalk(trigger_name)
    local sequences = TRASHTALK_MESSAGES[trigger_name]
    if not sequences or #sequences == 0 then
        return
    end

    local seq = sequences[client.random_int(1, #sequences)]
    local now = globals.realtime()
    local total_delay = 0
    for _, msg in ipairs(seq) do
        local text = msg[1]
        local delay = msg[2] or 0
        total_delay = total_delay + delay
        table.insert(
            trashtalk_queue,
            {
                send_at = now + total_delay,
                text = text
            }
        )
    end
end

local function process_trashtalk_queue()
    local now = globals.realtime()
    for i = #trashtalk_queue, 1, -1 do
        local item = trashtalk_queue[i]
        if now >= item.send_at then
            client.exec("say " .. item.text)
            table.remove(trashtalk_queue, i)
        end
    end
end

